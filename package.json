    "test:file": "node tests/file-protocol-check.js"
  },
  "type": "commonjs",
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-kufi-arabic": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "fake-indexeddb": "6.0.0",
    "pdf-lib": "1.17.1"
  }
}
